<Window x:Class="EasyConnect.ConnectionPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EasyConnect.Views"
        Width="340" Height="118" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        Topmost="True" Focusable="False" WindowStartupLocation="Manual">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="18" Padding="16" Effect="{DynamicResource PopupShadow}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="52" Height="52" CornerRadius="16" Background="{DynamicResource IconBackgroundBrush}">
                <views:DevicePhoto Width="42" Height="42" DataContext="{Binding Device}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource SecondaryText}" />
                <TextBlock Text="{Binding Device.DisplayName}" FontWeight="SemiBold" FontSize="16"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Device.DisplayName}" />
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <TextBlock Text="{Binding Device.ConnectionStatus, Converter={StaticResource ConnectionText}}" Style="{StaticResource SecondaryText}" />
                    <TextBlock Text=" · " Style="{StaticResource SecondaryText}" />
                    <TextBlock Text="{Binding Device.BatteryPercentage, Converter={StaticResource BatteryText}}" Style="{StaticResource SecondaryText}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
