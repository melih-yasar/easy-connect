<Window x:Class="EasyConnect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EasyConnect.Views"
        Title="EasyConnect" Width="900" Height="680" MinWidth="660" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>
    <Grid Margin="32,26,32,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,32">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" />
                <TextBlock Text="BLUETOOTH" FontSize="11" FontWeight="SemiBold" Style="{StaticResource SecondaryText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0">
                    <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="EasyConnect" FontWeight="SemiBold" FontSize="20" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Your devices" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource SecondaryText}" Margin="0,7,12,0"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource RefreshButton}"
                    VerticalAlignment="Center" ToolTip="Refresh paired devices (F5)" AutomationProperties.Name="Refresh devices">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               FontSize="15" VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock Text="Refresh" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </StackPanel>
            </Button>
        </Grid>
        <StackPanel Grid.Row="2">
            <Border Background="{DynamicResource NoticeBackgroundBrush}" BorderBrush="{DynamicResource NoticeBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Couldn’t refresh devices" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource NoticeBackgroundBrush}" BorderBrush="{DynamicResource NoticeBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16"
                    Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </Border>
            <StackPanel Margin="0,0,0,16" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar IsIndeterminate="{Binding IsLoading}" Height="3" BorderThickness="0"
                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource AccentSoftBrush}"
                             AutomationProperties.Name="Loading devices" />
                <TextBlock Text="Checking your paired devices…" Style="{StaticResource SecondaryText}" Margin="0,9,0,0" />
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="3">
            <ListBox ItemsSource="{Binding Devices}" Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling" SelectionMode="Single"
                     Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}}"
                     AutomationProperties.Name="Paired Bluetooth devices">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,3,10" />
                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding DeviceName}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card" CornerRadius="24" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="20,18">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <views:DeviceCard />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="24"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28">
                    <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,0,20">
                        <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="No paired devices yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Pair a Bluetooth device in Windows Settings, then select Refresh."
                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" MaxWidth="340" />
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Battery appears when Windows provides it. -- means unavailable."
                       Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,18,0" />
            <TextBlock Grid.Column="1" Text="{Binding LastUpdatedText}" Style="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Top" />
        </Grid>
    </Grid>
</Window>
