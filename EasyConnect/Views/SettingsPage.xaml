<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:EasyConnect.Models" xmlns:helpers="clr-namespace:EasyConnect.Helpers" x:Class="EasyConnect.Views.SettingsPage">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <Button Command="{Binding ToggleSettingsCommand}" Style="{StaticResource QuietButton}" ContentTemplate="{x:Null}" HorizontalAlignment="Left" ToolTip="Back to Bluetooth">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock Text="Back"/>
                </StackPanel>
            </Button>
            <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Margin="0,16,0,0"/>
            <TextBlock Text="Make EasyConnect work your way." Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/>
        </StackPanel>
        <ScrollViewer helpers:SlowScroll.IsEnabled="True" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="780" HorizontalAlignment="Stretch">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22,18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="General" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox Content="Start EasyConnect with Windows" IsChecked="{Binding StartWithWindows}" Style="{StaticResource SettingsToggle}"/>
                        <CheckBox Content="Start minimized to tray" IsChecked="{Binding StartMinimized}" Style="{StaticResource SettingsToggle}"/>
                        <CheckBox Content="Compact Mode" IsChecked="{Binding CompactMode}" Style="{StaticResource SettingsToggle}"/>
                        <CheckBox Content="Show only connected devices in Compact Mode" IsChecked="{Binding CompactConnectedOnly}" Style="{StaticResource SettingsToggle}" IsEnabled="{Binding CompactMode}"/>
                        <TextBlock Text="Compact Mode uses smaller device rows. Start minimized applies on your next launch." Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22,18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Notifications" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox Content="Show connection popup" IsChecked="{Binding ShowConnectionPopup}" Style="{StaticResource SettingsToggle}"/>
                        <CheckBox Content="Show disconnect popup" IsChecked="{Binding ShowDisconnectPopup}" Style="{StaticResource SettingsToggle}"/>
                        <CheckBox Content="Low battery notifications" IsChecked="{Binding LowBatteryNotifications}" Style="{StaticResource SettingsToggle}"/>
                        <StackPanel Margin="0,16,0,0" IsEnabled="{Binding LowBatteryNotifications}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding LowBatteryThreshold, StringFormat={}{0}%}" Style="{StaticResource SecondaryText}"/>
                                <TextBlock Text="Low battery threshold"/>
                            </DockPanel>
                            <Slider Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding LowBatteryThreshold}" AutomationProperties.Name="Low battery threshold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22,18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Appearance" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Text="Theme" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <RadioButton Content="System" GroupName="Theme" Style="{StaticResource ThemeChoice}" IsChecked="{Binding Theme, Converter={StaticResource ThemeChoiceConverter}, ConverterParameter=System}"/>
                            <RadioButton Content="Light" GroupName="Theme" Style="{StaticResource ThemeChoice}" IsChecked="{Binding Theme, Converter={StaticResource ThemeChoiceConverter}, ConverterParameter=Light}"/>
                            <RadioButton Content="Dark" GroupName="Theme" Style="{StaticResource ThemeChoice}" IsChecked="{Binding Theme, Converter={StaticResource ThemeChoiceConverter}, ConverterParameter=Dark}"/>
                        </WrapPanel>
                        <StackPanel Margin="0,16,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PopupDurationSeconds, StringFormat={}{0} seconds}" Style="{StaticResource SecondaryText}"/>
                                <TextBlock Text="Connection popup duration"/>
                            </DockPanel>
                            <Slider Minimum="2" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PopupDurationSeconds}" AutomationProperties.Name="Connection popup duration" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22,18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Bluetooth" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox Content="Automatic refresh / live monitoring" IsChecked="{Binding AutomaticRefresh}" Style="{StaticResource SettingsToggle}"/>
                        <TextBlock Text="Checks paired devices periodically for connection and battery changes." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
                        <StackPanel Margin="0,16,0,0" IsEnabled="{Binding AutomaticRefresh}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding RefreshIntervalSeconds, StringFormat={}{0} seconds}" Style="{StaticResource SecondaryText}"/>
                                <TextBlock Text="Refresh interval"/>
                            </DockPanel>
                            <Slider Minimum="5" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding RefreshIntervalSeconds}" AutomationProperties.Name="Refresh interval" Margin="0,8,0,0"/>
                        </StackPanel>
                        <Button Content="Open Windows Bluetooth settings" Command="{Binding SettingsCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Text="{Binding SettingsStatus}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</UserControl>
