<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:EasyConnect.Views" xmlns:helpers="clr-namespace:EasyConnect.Helpers" x:Class="EasyConnect.Views.BluetoothPage">

        <Grid x:Name="DashboardLayout" Margin="20,14" helpers:SlowScroll.IsEnabled="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MaxHeight="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding ToggleSettingsCommand}" Style="{StaticResource QuietButton}" ContentTemplate="{x:Null}" ToolTip="Settings" AutomationProperties.Name="Settings" FontFamily="Segoe MDL2 Assets" FontSize="17" Content="" Height="40" Width="40" Padding="0" Margin="0,0,10,0"/>
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource QuietButton}" ContentTemplate="{x:Null}" ToolTip="Refresh devices (F5)" AutomationProperties.Name="Refresh devices" FontFamily="Segoe MDL2 Assets" FontSize="17" Content="" Height="40" Width="40" Padding="0" Margin="0,0,10,0"/>

                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="9" Width="30" Height="30" Margin="0,0,10,0">
                        <TextBlock Text="" Foreground="{DynamicResource OnAccentBrush}" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="EasyConnect" FontWeight="SemiBold" FontSize="17" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="230"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Bluetooth" FontSize="28" FontWeight="SemiBold"/>
                    <WrapPanel Margin="0,4,0,0"><TextBlock Text="{Binding SummaryText}" Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,0,12,0"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AutomaticRefresh}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource ConnectedBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding MonitoringText}" Style="{StaticResource SecondaryText}" FontSize="11" ToolTip="Connection status is checked at the interval in Settings."/>
                    </StackPanel></WrapPanel>
                </StackPanel>
                <TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DeviceSearchField}" ToolTip="Filter paired devices" AutomationProperties.Name="Search paired devices"/>

            </Grid>
            <Border Grid.Row="2" CornerRadius="20" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,10" Visibility="{Binding HasSelectedDevice, Converter={StaticResource BoolToVisibility}}">
                <Grid DataContext="{Binding SelectedDevice}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <views:DevicePhoto Width="64" Height="64" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding ConnectionStatus, Converter={StaticResource ConnectionText}}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,0,0,5"/>
                        <Grid>
                            <TextBlock Text="{Binding DisplayName}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceName}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsEditingDevice, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <DockPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding IsEditingDevice, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                                    <Button Command="{Binding SaveDeviceEditCommand}" Style="{StaticResource DeviceIconButton}" ToolTip="Save name (Enter)" AutomationProperties.Name="Save device name"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button>
                                    <Button Command="{Binding CancelEditCommand}" Style="{StaticResource DeviceIconButton}" ToolTip="Cancel (Escape)" AutomationProperties.Name="Cancel name edit"><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"/></Button>
                                </StackPanel>
                                <TextBox Text="{Binding EditDeviceName, UpdateSourceTrigger=PropertyChanged}" FontSize="22" FontWeight="SemiBold" Padding="5,2" MaxLength="120" AutomationProperties.Name="Device name" ToolTip="Name in EasyConnect. Leave blank to use the original name." IsVisibleChanged="FocusNameEditor" Style="{StaticResource PlaceholderField}" Tag="Device name">
                                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SaveDeviceEditCommand}"/><KeyBinding Key="Escape" Command="{Binding CancelEditCommand}"/></TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <TextBlock Text="{Binding BatteryLabel}" FontSize="13"/>
                            <ProgressBar Value="{Binding BatteryPercentage, TargetNullValue=0}" Maximum="100" Width="76" Height="6" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}" Foreground="{Binding BatteryPercentage, Converter={StaticResource BatteryBrush}}" Background="{DynamicResource IconBackgroundBrush}" BorderThickness="0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                        <Button Style="{StaticResource DeviceIconButton}" ToolTip="Edit device" AutomationProperties.Name="Edit device" Command="{Binding DataContext.EditDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,0">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                        </Button>
                        <Button Style="{StaticResource DeviceIconButton}" AutomationProperties.Name="Device information" ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="30000" Click="ShowDeviceInformation">
                            <Viewbox Width="19" Height="19"><Grid Width="20" Height="20"><Ellipse Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.4"/><TextBlock Text="i" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></Grid></Viewbox>
                            <Button.ToolTip>
                                <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" MaxWidth="290" Padding="14" Placement="Bottom">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <TextBlock Text="{Binding CategoryLabel}"/>
                                        <TextBlock Text="{Binding SignalLabel}" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding SignalDetail}" Style="{StaticResource SecondaryText}" FontSize="11"/>
                                        <TextBlock Text="{Binding ConnectionStatus, Converter={StaticResource ConnectionText}}" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding BatteryLabel}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                    <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <Button Content="{Binding Converter={StaticResource DeviceActionText}}" Style="{StaticResource RefreshButton}" Padding="18,10" MinWidth="182" Height="40" Margin="0,0,8,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding DataContext.DeviceActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource FavoriteButton}" MinWidth="150" Margin="0" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IsFavorite, Converter={StaticResource FavoriteGlyph}}" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" TextAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Favorite"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Text" Value="Favorited"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                            </WrapPanel>


                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <Border Background="{DynamicResource NoticeBackgroundBrush}" BorderBrush="{DynamicResource NoticeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                </Border>
                <Border Background="{DynamicResource NoticeBackgroundBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,12" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap"/>
                </Border>
                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,12" Visibility="{Binding HasOperationMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding OperationMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </Border>
                <ProgressBar IsIndeterminate="{Binding IsLoading}" Height="3" BorderThickness="0" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Refreshing devices"/>
                <TextBlock Text="Updating your device..." Style="{StaticResource SecondaryText}" Margin="0,0,0,12" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            </ScrollViewer>
            <Grid x:Name="DevicePanels" Grid.Row="4" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="6,0,0,8">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding FilteredDeviceCountText}" Style="{StaticResource SecondaryText}" Margin="12,1,10,0"/>
                            <TextBlock Text="My devices" FontWeight="SemiBold" FontSize="16"/>
                        </DockPanel>
                        <ListBox VirtualizingPanel.ScrollUnit="Pixel" Grid.Row="1" ItemsSource="{Binding VisibleDevices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ItemContainerStyle="{StaticResource DeviceListItem}" AutomationProperties.Name="Paired devices">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <views:DeviceCard/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="1" Text="No devices match your search or Compact Mode filter." TextWrapping="Wrap" Margin="16" Style="{StaticResource SecondaryText}" Visibility="{Binding HasNoFilterMatches, Converter={StaticResource BoolToVisibility}}"/>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="20" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Your next connection starts here." FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Text="Find a nearby device and pair it in Windows. It will appear here when you refresh." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Column="2">
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                <Grid DockPanel.Dock="Right" Margin="8,0,0,0">
                                    <Button Command="{Binding DiscoverCommand}" ContentTemplate="{x:Null}" Height="34" Padding="10,7" ToolTip="Discover nearby Bluetooth devices" AutomationProperties.Name="Find nearby devices">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RefreshButton}">
                                                <Style.Triggers><DataTrigger Binding="{Binding IsDiscovering}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource OnAccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Find nearby" FontSize="12" Foreground="{DynamicResource OnAccentBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Stop scan" Command="{Binding StopDiscoveryCommand}" Style="{StaticResource QuietButton}" Height="34" Padding="10,7" ToolTip="Stop nearby discovery" Visibility="{Binding IsDiscovering, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                                <TextBlock Text="Nearby" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="{Binding DiscoveryMessage}" Style="{StaticResource SecondaryText}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding DiscoveryMessage}" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite"/>
                                <ProgressBar Height="3" IsIndeterminate="{Binding IsDiscovering}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Margin="0,0,0,12" Visibility="{Binding IsDiscovering, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                            <ListBox VirtualizingPanel.ScrollUnit="Pixel" Grid.Row="2" ItemsSource="{Binding NearbyDevices}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource DeviceListItem}" AutomationProperties.Name="Nearby devices">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <views:DevicePhoto Width="32" Height="32"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceName}"/>
                                                    <TextBlock Text="{Binding SignalLabel}" Style="{StaticResource SecondaryText}" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                            <Button Content="Pair" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="42,8,0,0" Padding="10,6" Command="{Binding DataContext.PairDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="4" Visibility="{Binding ShowNearbyPlaceholder, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="28" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="Ready when your device is." TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" Style="{StaticResource SecondaryText}"/>
                            </StackPanel>
                            
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <DockPanel x:Name="DashboardFooter" Grid.Row="5" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Bluetooth Settings" Command="{Binding SettingsCommand}" Style="{StaticResource QuietButton}" Padding="10,5"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource SecondaryText}" FontSize="11"/>
                    
                </StackPanel>
            </DockPanel>
        </Grid>

</UserControl>
