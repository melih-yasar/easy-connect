<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Apple-inspired neutral surfaces, restrained blue actions, and semantic color roles. -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="TextBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#62626B" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E4E4E7" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0071E3" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#194BC6" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF0FF" />
    <SolidColorBrush x:Key="IconBackgroundBrush" Color="#F0F0F2" />
    <SolidColorBrush x:Key="ConnectedBrush" Color="#167447" />
    <SolidColorBrush x:Key="ConnectedSoftBrush" Color="#E5F5EB" />
    <SolidColorBrush x:Key="NoticeBackgroundBrush" Color="#FFF7E8" />
    <SolidColorBrush x:Key="NoticeBorderBrush" Color="#E8CFA6" />
</ResourceDictionary>
